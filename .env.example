# PostgreSQL connection string (Supabase, Neon, Railway or local Postgres)
# Supabase / Neon: copy the "connection string" from the dashboard (add ?sslmode=require if needed)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Long random string used to sign admin session cookies (JWT). Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# First-run admin account (only used when no admin exists yet). Change it later in /admin → Credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: public URL used for sitemap.xml / robots.txt / canonical links (can also be set in admin → Site Settings)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
